# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/video_saas_dev?schema=public"

# Redis (used by BullMQ for background job queuing)
REDIS_URL="redis://localhost:6379"

# Auth (e.g. NextAuth.js)
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Stripe billing
STRIPE_SECRET_KEY=""                   # sk_live_... or sk_test_...
STRIPE_WEBHOOK_SECRET=""               # whsec_... (from Stripe CLI or dashboard)
STRIPE_STARTER_PRICE_ID=""             # price_... for the $14 Starter plan

# AI providers
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ElevenLabs TTS
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""          # optional — defaults to Rachel (21m00Tcm4TlvDq8ikWAM)

# Storage (AWS S3 or Cloudflare R2)
STORAGE_BUCKET=""
STORAGE_REGION=""               # "auto" for R2, e.g. "us-east-1" for S3
STORAGE_ENDPOINT=""             # R2 only: https://<account-id>.r2.cloudflarestorage.com
STORAGE_PUBLIC_URL=""           # public base URL, e.g. https://assets.example.com
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
