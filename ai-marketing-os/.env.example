# ============================================
# AI MARKETING OS - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control

# ============================================
# APPLICATION
# ============================================
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-super-secret-key-minimum-32-characters-long-change-this
FRONTEND_URL=http://localhost:3000

# ============================================
# DATABASE
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_marketing_os
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_marketing_os

# ============================================
# REDIS
# ============================================
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================
# AI PROVIDERS
# ============================================
# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
OPENAI_DEFAULT_MODEL=gpt-4o

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=AIza...
GOOGLE_DEFAULT_MODEL=gemini-1.5-pro

# xAI Grok (https://console.x.ai)
GROK_API_KEY=xai-...
GROK_DEFAULT_MODEL=grok-beta
GROK_BASE_URL=https://api.x.ai/v1

# ============================================
# SOCIAL PUBLISHING
# ============================================
# Meta / Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# WordPress
WORDPRESS_DEFAULT_URL=

# ============================================
# ADS PLATFORMS
# ============================================
# Meta Ads
META_ADS_ACCESS_TOKEN=
META_ADS_APP_ID=
META_ADS_APP_SECRET=

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# TikTok Ads
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADS_APP_ID=

# ============================================
# OBSERVABILITY
# ============================================
SENTRY_DSN=
LOG_LEVEL=INFO

# ============================================
# ENCRYPTION
# ============================================
# Key for encrypting sensitive data like ad credentials
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ============================================
# PORTS (for docker-compose)
# ============================================
BACKEND_PORT=8000
FRONTEND_PORT=3000
