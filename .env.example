# Anthropic API Key (bắt buộc)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Facebook App credentials (bắt buộc)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Page Access Tokens - thêm theo format PAGE_TOKEN_<TÊN_PAGE>
# Ví dụ:
PAGE_TOKEN_COMPANY_PAGE=your_page_access_token_here
PAGE_TOKEN_PRODUCT_PAGE=your_second_page_access_token_here

# Page IDs tương ứng
PAGE_ID_COMPANY_PAGE=123456789
PAGE_ID_PRODUCT_PAGE=987654321

# Meta MCP Server - Instagram & Threads (@mikusnuz/meta-mcp)
# Lấy tại: https://developers.facebook.com/tools/explorer/
INSTAGRAM_ACCESS_TOKEN=your_instagram_long_lived_token
INSTAGRAM_USER_ID=your_instagram_business_account_id
THREADS_ACCESS_TOKEN=your_threads_access_token
THREADS_USER_ID=your_threads_user_id
